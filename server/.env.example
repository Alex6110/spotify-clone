# Copia questo file in server/.env e compila i valori. Non committare mai .env.

# Database (SQLite per ora; in seguito Postgres sul server di casa)
DATABASE_URL="file:../data/app.db"

# Segreto per firmare i token: genera con
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5001

# Cartella della musica (Artista/Album/NN - Titolo.ext).
# Mac:   /Volumes/TOSHIBA_EXT/Raccolta musica
# Linux: /srv/music
MUSIC_DIR=/Volumes/TOSHIBA_EXT/Raccolta musica

# Dove il server salva cover e foto artisti estratte/scaricate
DATA_DIR=./data

# Opzionale: cartelle delle vecchie cover (img/covers e img/artist) da riusare nella scansione
LEGACY_COVERS_DIR=
LEGACY_ARTIST_DIR=

# Origini consentite dal browser, separate da virgola (vuoto = stessa origine)
CORS_ORIGINS=http://localhost:5173

# Registrazione: "open" oppure "invite" (richiede INVITE_CODE)
REGISTRATION=invite
INVITE_CODE=

# Metti 1 se il server sta dietro a un reverse proxy (Caddy) sulla stessa macchina
TRUST_PROXY=0

# Caricamento di musica dall'app (true/false) e dimensione massima per file in MB
ALLOW_UPLOAD=true
MAX_UPLOAD_MB=600
