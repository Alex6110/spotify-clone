# Frontend (opzionale). Copia in .env se ti serve.

# Indirizzo del backend usato dal proxy di sviluppo di Vite (npm run dev)
# VITE_DEV_API_TARGET=http://127.0.0.1:5001

# Solo se il frontend compilato è servito da un'origine diversa dal backend.
# Se lo servi dal backend stesso (consigliato) lascia vuoto.
# VITE_API_URL=https://musica.mio-server.ts.net
